# Copy to .env and fill in: cp .env.example .env
# Only NAVICAST_DB_PASSWORD has no default (required).
NAVICAST_DB_PASSWORD=change-me
NAVICAST_DB_NAME=ais_project
NAVICAST_DB_USER=postgres
# Local runs: localhost. docker compose overrides this to the postgres service.
NAVICAST_DB_HOST=localhost
NAVICAST_DB_PORT=5432
NAVICAST_CORS_ORIGINS=http://localhost:3000
NAVICAST_MODEL_PATH=vessel_prediction_model.pkl
PORT=8000
