# Local demo; the Docker Compose demo service also defaults to this mode.
NAVICAST_MODE=demo
PORT=8000

# Live profile: replace the local-only password before using beyond a dev machine.
NAVICAST_DB_NAME=ais_project
NAVICAST_DB_USER=postgres
NAVICAST_DB_PASSWORD=local-development-only
NAVICAST_DB_HOST=localhost
NAVICAST_DB_PORT=5432
LIVE_PORT=8001
