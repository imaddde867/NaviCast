{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "navicast",
  "account_id": "a9b21695a21bf07980d486637f1a5a6e",
  "workers_dev": false,
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "navicast.imadlab.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *", "10 0 * * *"] },
  "d1_databases": [
    {
      "binding": "AIS_ARCHIVE_DB",
      "database_name": "navicast-ais-archive",
      // Owner replaces this placeholder only after confirming Workers Free.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
