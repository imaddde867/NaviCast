{
  "name": "navicast",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='cloudflare/**' --test-reporter=spec --test-reporter=lcov --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/node.lcov --test-reporter-destination=reports/node.xml tests/*.test.cjs tests/*.test.mjs",
    "report:browser-coverage": "node scripts/report_browser_coverage.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "test:runtime": "vitest run",
    "test:ci": "node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/node.xml tests/*.test.cjs tests/*.test.mjs",
    "check:bundle": "node scripts/check_bundle.mjs"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "miniflare": "5.20261006.1-alpha",
    "v8-to-istanbul": "9.3.0",
    "vitest": "5.0.4",
    "wrangler": "4.149.0"
  }
}
